{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://myaieditor.com https://myaiediter.com https://*.vercel.app http://localhost:3000 http://localhost:*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/meet-your-curbelo-coach", "destination": "/about/", "permanent": true },
    { "source": "/meet-your-curbelo-coach/", "destination": "/about/", "permanent": true },
    { "source": "/learn-more", "destination": "/how-we-help/", "permanent": true },
    { "source": "/learn-more/", "destination": "/how-we-help/", "permanent": true },
    { "source": "/resources/the-dog-days-of-summer", "destination": "/blog/dog-days-of-summer/", "permanent": true },
    { "source": "/resources/the-dog-days-of-summer/", "destination": "/blog/dog-days-of-summer/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible-66gma", "destination": "/blog/goal-vs-why/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible-66gma/", "destination": "/blog/goal-vs-why/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible", "destination": "/blog/holiday-spending/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible/", "destination": "/blog/holiday-spending/", "permanent": true }
  ]
}
