{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/meet-your-curbelo-coach/:path*", "destination": "/about/", "permanent": true },
    { "source": "/learn-more/:path*", "destination": "/how-we-help/", "permanent": true },
    { "source": "/resources/the-dog-days-of-summer/:path*", "destination": "/blog/dog-days-of-summer/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible-66gma/:path*", "destination": "/blog/goal-vs-why/", "permanent": true },
    { "source": "/resources/holiday-spending-and-being-financially-responsible/:path*", "destination": "/blog/holiday-spending/", "permanent": true }
  ]
}
